#!/usr/bin/env python3
"""claude-sync — apply ~/dotfiles/claude/config.json to every Claude seat on this machine: set the
settings it lists (the status line, no attribution or session link in commits and pull requests),
add the hooks it lists (claude-commit-guard), install and enable its plugins, and say which language
servers are missing.

A seat is ~/.claude or a ~/.claude-<name> directory with a settings.json; seats whose settings and
plugins are links to another seat's (the Mac's team seats share ~/.claude's) are done once. Settings
keys it lists are replaced as a whole; other keys are left alone. Hooks and plugins are only added (and
plugins enabled, at user scope), never removed.

  claude-sync           apply what differs
  claude-sync --check   report only; exits 1 when something differs
"""
import glob, json, os, platform, shutil, subprocess, sys

HOME = os.path.expanduser("~")
LIST = os.path.join(os.environ.get("DOTFILES", f"{HOME}/dotfiles"), "claude", "config.json")
CHECK = "--check" in sys.argv[1:]


def seats():
    found, seen = [], set()
    for d in [f"{HOME}/.claude", *sorted(glob.glob(f"{HOME}/.claude-*"))]:
        settings = os.path.join(d, "settings.json")
        if not os.path.isdir(d) or not os.path.exists(settings):
            continue
        key = (os.path.realpath(settings), os.path.realpath(os.path.join(d, "plugins")))
        if key in seen:
            continue
        seen.add(key)
        found.append(d)
    return found


def claude(seat, *args):
    env = dict(os.environ)
    env.pop("CLAUDE_CONFIG_DIR", None)
    if seat != f"{HOME}/.claude":
        env["CLAUDE_CONFIG_DIR"] = seat
    return subprocess.run(["claude", "plugin", *args], env=env, capture_output=True, text=True, timeout=300)


def as_json(result):
    try:
        return json.loads(result.stdout or "[]")
    except ValueError:
        return []


def main():
    want = json.load(open(LIST))
    missing = 0
    for seat in seats():
        label = seat.replace(HOME, "~")
        path = os.path.realpath(os.path.join(seat, "settings.json"))
        settings = json.load(open(path))
        stale = [k for k, v in want.get("settings", {}).items() if settings.get(k) != v]
        hooks = settings.get("hooks", {})
        absent = [(e, g) for e, groups in want.get("hooks", {}).items() for g in groups if g not in hooks.get(e, [])]
        changes = stale + [f"{e} hook {h['command']}" for e, g in absent for h in g["hooks"]]
        if changes:
            missing += 1
            if CHECK:
                print(f"{label}: settings differ: {', '.join(changes)}")
            else:
                settings.update({k: want["settings"][k] for k in stale})
                for e, g in absent:
                    settings.setdefault("hooks", {}).setdefault(e, []).append(g)
                with open(path, "w") as f:
                    f.write(json.dumps(settings, indent=2, ensure_ascii=False) + "\n")
                print(f"{label}: set {', '.join(changes)}")
        have_markets = {m.get("name") for m in as_json(claude(seat, "marketplace", "list", "--json"))}
        for name, repo in want.get("marketplaces", {}).items():
            if name not in have_markets:
                missing += 1
                if CHECK:
                    print(f"{label}: marketplace {name} missing")
                else:
                    r = claude(seat, "marketplace", "add", repo, "--scope", "user")
                    print(f"{label}: added marketplace {name}" if r.returncode == 0 else f"{label}: adding {name} failed: {r.stderr.strip()[-200:]}")
        user = {p["id"]: p for p in as_json(claude(seat, "list", "--json")) if p.get("scope") == "user"}
        for pid in want.get("plugins", []):
            p = user.get(pid)
            if p and p.get("enabled"):
                continue
            missing += 1
            action = "enable" if p else "install"
            if CHECK:
                print(f"{label}: {pid} needs {action}")
                continue
            r = claude(seat, action, pid, "--scope", "user")
            print(f"{label}: {action}ed {pid}" if r.returncode == 0 else f"{label}: {action} {pid} failed: {(r.stderr or r.stdout).strip()[-200:]}")
    os_key = "macos" if platform.system() == "Darwin" else "linux"
    for pid, ls in want.get("language_servers", {}).items():
        if pid in want.get("plugins", []) and not shutil.which(ls["binary"]):
            print(f"language server missing for {pid}: {ls['binary']} (install: {ls[os_key]})")
    if CHECK and missing:
        sys.exit(1)


if __name__ == "__main__":
    main()
